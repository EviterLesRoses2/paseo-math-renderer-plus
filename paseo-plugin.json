{
  "id": "math-renderer-plus",
  "name": "Math Renderer Plus",
  "description": "Render LaTeX and Chinese formula labels locally in Paseo replies.",
  "requirements": { "paseo": ">=0.13.0" },
  "translations": {
    "zh-CN": {
      "name": "公式渲染增强版",
      "description": "在 Paseo 回复中本地渲染 LaTeX 公式和中文标签。"
    }
  },
  "media": ["images/desktop.png", "images/desktop-dark.png"],
  "build": [
    ["npm", "ci", "--ignore-scripts", "--legacy-peer-deps", "--no-audit", "--no-fund"],
    ["npm", "run", "prepare:markdown"],
    ["npm", "run", "prepare:wasm"],
    ["npm", "run", "prepare:engine"],
    ["npm", "run", "typecheck"]
  ]
}
