{
  "name": "paseo-math-renderer-plus",
  "version": "1.4.0",
  "type": "module",
  "description": "Local LaTeX and Chinese formula rendering for Paseo, verified on iPhone",
  "license": "MIT",
  "author": "EviterLesRoses2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EviterLesRoses2/paseo-math-renderer-plus.git"
  },
  "homepage": "https://github.com/EviterLesRoses2/paseo-math-renderer-plus#readme",
  "bugs": {
    "url": "https://github.com/EviterLesRoses2/paseo-math-renderer-plus/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "math",
    "latex",
    "mathjax"
  ],
  "scripts": {
    "prepare:markdown": "node server/prepare-markdown.mjs",
    "prepare:wasm": "node server/prepare-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern server/generated --ignore-pattern shared/generated --ignore-pattern tests/fixtures",
    "test": "vitest run --maxWorkers=2",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare:engine": "node server/prepare-engine.mjs"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@resvg/resvg-wasm": "2.6.2",
    "fontkit": "2.0.4"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.2",
    "@getpaseo/plugin": "0.13.2",
    "@getpaseo/protocol": "0.13.2",
    "@tanstack/react-query": "5.90.11",
    "@types/fontkit": "2.0.9",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "0.28.1",
    "markdown-it": "14.3.3",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "zod": "4.6.7"
  }
}
